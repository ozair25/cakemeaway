{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Bakery items like cakes, pastries, snacks, etc.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "status": { "type": "string", "enum": ["in-stock", "low-stock", "out-of-stock"] },
        "isBestseller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase records.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Preparing", "Baking", "Out for Delivery", "Delivered", "Cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Paid", "Failed"] },
        "paymentMethod": { "type": "string" },
        "deliveryAddress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerId", "items", "total", "status"]
    },
    "User": {
      "title": "User",
      "description": "Customer and staff profiles.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff", "customer"] },
        "addresses": { "type": "array" },
        "points": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "CustomInquiry": {
      "title": "Custom Inquiry",
      "description": "Custom cake requests.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "occasion": { "type": "string" },
        "flavor": { "type": "string" },
        "weight": { "type": "number" },
        "referenceImage": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "In Production", "Completed", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["occasion", "deliveryDate", "status"]
    },
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "General inquiries from contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "replied", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "status"]
    },
    "BakerySettings": {
      "title": "Bakery Settings",
      "description": "Global settings for the bakery store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "address": { "type": "string" },
        "socials": { "type": "object" },
        "deliveryTimings": { "type": "object" },
        "promoBanner": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of bakery products."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/customInquiries/{inquiryId}": {
      "schema": "CustomInquiry",
      "description": "Custom cake inquiries."
    },
    "/contactInquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "General contact form submissions."
    },
    "/settings/global": {
      "schema": "BakerySettings",
      "description": "Global store configuration."
    }
  }
}
