rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      let data = getUserData();
      return isSignedIn() && (data.role == 'admin' || data.role == 'staff');
    }

    // Entity Validations
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.status in ['in-stock', 'low-stock', 'out-of-stock'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'items', 'total', 'status']) &&
             data.customerId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['Pending', 'Confirmed', 'Preparing', 'Baking', 'Out for Delivery', 'Delivered', 'Cancelled'];
    }

    // 1. Products: Public Read, Staff Write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isStaff() && isValidProduct(request.resource.data);
    }

    // 2. Orders: Owner Read/Create, Staff Manage
    match /orders/{orderId} {
      allow get: if isOwner(resource.data.customerId) || isStaff();
      allow list: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isStaff();
      allow create: if isSignedIn() && isValidOrder(request.resource.data);
      allow update: if isStaff();
    }

    // 3. Users: Owner Read/Write (limited), Staff Manage
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isStaff();
    }

    // 4. Custom Inquiries
    match /customInquiries/{inquiryId} {
      allow create: if isSignedIn();
      allow read, update: if isOwner(resource.data.customerId) || isStaff();
    }
    
    // 5. Admins Collection (Role Source of Truth)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable through Firebase Console or Cloud Functions
    }
  }
}
